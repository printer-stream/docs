# Copy this file to .env and adjust the values for your environment.
# In Docker the data volume is typically mounted at /data; for a bare-repo
# checkout set DOCS_REPO_ROOT to the repository root instead.

# ---------------------------------------------------------------------------
# Data paths
# ---------------------------------------------------------------------------

# Repo / data root — md/, jpeg/, and index/ are expected as sub-directories.
# All path vars below default to {DOCS_REPO_ROOT}/<name> when not set.
DOCS_REPO_ROOT=/data

# SQLite search index produced by indexer.py.
DOCS_INDEX_PATH=/data/index/specs.db

# Per-page Markdown slices (one file per PDF page).
# DOCS_MD_DIR=/data/md

# Bulk / full-document Markdown exports.
# DOCS_MD_BULK_DIR=/data/md-bulk

# JPEG thumbnails (small + big) for each page.
# DOCS_JPEG_DIR=/data/jpeg

# ---------------------------------------------------------------------------
# Embedding model + chunking
# ---------------------------------------------------------------------------

# Sentence-transformer model used to build and query the vector index.
# Must match the model that was used when the index was last built (the server
# verifies this against the index metadata and refuses to start on a mismatch).
DOCS_EMBED_MODEL=BAAI/bge-small-en-v1.5

# Instruction prefix prepended to queries only (BGE retrieval models expect it).
# DOCS_EMBED_QUERY_PREFIX=Represent this sentence for searching relevant passages:

# Token-window sizing for long page bodies (must fit the embed model context).
# DOCS_CHUNK_TOKENS=400
# DOCS_CHUNK_OVERLAP=50

# ---------------------------------------------------------------------------
# Summarisation (local, no external API)
# ---------------------------------------------------------------------------

# Backend: 'extractive' (default) uses the page-1 spec overview — on-topic and
# free on this corpus. 'local' runs a transformers seq2seq model instead.
DOCS_SUMMARY_BACKEND=extractive

# Local instruction-tuned seq2seq model used when backend == 'local'. Fetched on
# demand at index time (not pre-baked into the deps image). flan-t5-base tends to
# parrot dense spec text; flan-t5-large follows the instruction better but is ~3GB.
# DOCS_SUMMARY_MODEL=google/flan-t5-base

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# HOST=0.0.0.0
# PORT=8000

# Log verbosity: DEBUG | INFO | WARNING | ERROR
# DOCS_LOG_LEVEL=INFO

# Set to 1 to see download/HTTP chatter from HuggingFace and httpx.
# DOCS_VERBOSE_DEPS=0
