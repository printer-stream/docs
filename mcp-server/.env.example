# Copy to .env for local runs. Values here are read by the server; any matching
# environment variable overrides the .env value. In production set these via the
# environment (e.g. the Render dashboard) rather than committing a .env.

# Baked search index (default works inside the image).
DOCS_DB_PATH=/app/index/specs.db

# Directory to self-serve static assets from. Ignored if it does not exist
# (the lean image, unless a volume is mounted here).
DOCS_STATIC_DIR=/app/static

# Public base URL of this server, e.g. https://docs.printer-stream.com
# Used to build ABSOLUTE asset URLs (remote MCP clients need these to fetch images).
DOCS_BASE_URL=

# Where static assets live. Defaults to DOCS_BASE_URL. Point at a CDN to move
# static off this server - that is the only change needed.
DOCS_STATIC_BASE_URL=

# Listen address. Render provides PORT (default 10000).
HOST=0.0.0.0
PORT=10000

LOG_LEVEL=INFO

# Search result sizing.
DOCS_SEARCH_K=15
DOCS_SEARCH_MAX_K=50
