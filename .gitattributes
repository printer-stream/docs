# Git LFS - binary build artifacts. Run `git lfs install` once before committing.
# Per-page JPEG renders (small previews + full-resolution).
data-extraction/jpeg/**/*.jpg filter=lfs diff=lfs merge=lfs -text
# Pre-generated search indexes (SQLite FTS5 and any future binary index types).
data-extraction/index/**/*.db filter=lfs diff=lfs merge=lfs -text

# Keep markdown, json, and source under normal git (text, diffable).
