{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://printer-stream.com/schemas/pagemap.json",
  "title": "Pagemap",
  "description": "Authoritative page<->artifact map for one source document, assembled from the per-phase outputs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stem",
    "vendor",
    "doc",
    "source_pdf",
    "page_count",
    "pad_width",
    "pipeline_version",
    "generated_at",
    "phases",
    "pages"
  ],
  "properties": {
    "stem": {
      "type": "string",
      "description": "Vendor-rooted path without extension, e.g. star/star_graphic_cm_en.",
      "pattern": "^[^/]+/[^/]+$"
    },
    "vendor": { "type": "string", "minLength": 1 },
    "doc": { "type": "string", "minLength": 1 },
    "source_pdf": {
      "type": "string",
      "description": "Repo-relative path to the source PDF.",
      "pattern": "^pdf/.+\\.pdf$"
    },
    "page_count": { "type": "integer", "minimum": 1 },
    "pad_width": {
      "type": "integer",
      "minimum": 1,
      "description": "Zero-pad width for page-NN filenames; derived from page_count."
    },
    "pipeline_version": { "type": "string", "minLength": 1 },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC ISO-8601 timestamp of the assemble phase."
    },
    "phases": {
      "type": "object",
      "description": "Per-phase lineage and timing, keyed by phase name (render, text, markdown, describe, quality).",
      "additionalProperties": { "$ref": "#/$defs/phase" }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "phase": {
      "type": "object",
      "description": "Timing and toolchain identity for one phase, copied from meta/<stem>/<phase>.json.",
      "additionalProperties": true,
      "properties": {
        "tool": { "type": "string" },
        "tool_version": { "type": "string" },
        "duration_seconds": { "type": ["number", "null"] },
        "per_page_seconds_avg": { "type": ["number", "null"] },
        "started_at": { "type": "string" },
        "ended_at": { "type": "string" },
        "params": { "type": "object" },
        "status": { "type": "string" }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "label", "markdown", "jpeg_small", "jpeg_big", "source"],
      "properties": {
        "page": { "type": "integer", "minimum": 1 },
        "label": {
          "type": "string",
          "description": "Zero-padded page label, e.g. page-01.",
          "pattern": "^page-[0-9]+$"
        },
        "markdown": { "type": "string", "description": "Repo-relative path to the page slice." },
        "text": { "type": "string", "description": "Repo-relative path to the raw text-layer slice." },
        "jpeg_small": { "type": "string" },
        "jpeg_big": { "type": "string" },
        "describe": {
          "type": "string",
          "description": "Repo-relative path to the optional VLM page description."
        },
        "source": {
          "type": "string",
          "description": "Extraction method credited with this page's markdown.",
          "enum": ["text-layer", "ocr", "vlm"]
        },
        "quality_score": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence from the quality phase."
        },
        "flagged": {
          "type": "boolean",
          "description": "True when the page fell below the quality gate and needs review."
        }
      }
    }
  }
}
